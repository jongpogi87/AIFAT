# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js & vite build
/.next/
/out/
/dist/
/.vinext/

# misc
.DS_Store

# debug & logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files and secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*
!.env.example

# generated secret files
.session-secret*
*.secret
*.secret.*

# private keys & certificates
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx

# Firebase emulator local data & service account keys
.firebase/
firebase-debug.log*
firestore-debug.log*
ui-debug.log*
pubsub-debug.log*
emulator-data/
*service-account*.json
*serviceAccount*.json
*-firebase-adminsdk-*.json
service-account.json

# Database files
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm

# vercel & cloudflare & local runtimes
.vercel
/.wrangler/
/.sites-runtime/
/outputs/
/work/

# typescript
next-env.d.ts
