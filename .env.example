# ==============================================================================
# AIFAT REGISTRATION SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION SETTINGS
# ------------------------------------------------------------------------------
NODE_ENV=production
NEXT_PUBLIC_APP_URL=http://localhost:5173

# Data Backend Selection: 'firestore' (production/cloud) | 'memory' (local dev) | 'd1' (legacy fallback)
DATA_BACKEND=firestore

# Session Secret (Legacy / Local-development only: used by legacy D1/memory fallback to sign HMAC session tokens)
# Note: Firebase production authentication uses Firebase Auth Admin SDK and does not depend on SESSION_SECRET.
SESSION_SECRET=YOUR_LOCAL_DEV_HMAC_SESSION_SECRET_HERE

# ------------------------------------------------------------------------------
# 2. GOOGLE FIREBASE CONFIGURATION (PRIMARY PRODUCTION BACKEND)
# Project: aifat-registration
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=aifat-registration
NEXT_PUBLIC_FIREBASE_PROJECT_ID=aifat-registration
NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=aifat-registration.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=aifat-registration.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_FIREBASE_MESSAGING_SENDER_ID
NEXT_PUBLIC_FIREBASE_APP_ID=YOUR_FIREBASE_WEB_APP_ID

# Optional: Firebase Local Emulator Suite Ports (for offline emulator testing only)
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=localhost:8080
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# FIRESTORE_EMULATOR_HOST=localhost:8080

# ------------------------------------------------------------------------------
# 3. OPERATIONAL CONTACT CONFIGURATION (PLACEHOLDERS ONLY)
# ------------------------------------------------------------------------------
OFFICE_NAME=[Pending Official TSS Announcement]
OFFICE_ADDRESS=[Pending Official TSS Announcement]
OFFICE_HOURS=[Pending Official TSS Announcement]
CONTACT_PHONE=[Pending Official TSS Announcement]
CONTACT_EMAIL=[Pending Official TSS Announcement]

# ------------------------------------------------------------------------------
# 4. LEGACY CLOUDFLARE D1 / WORKERS FALLBACK CONFIGURATION (OPTIONAL / FALLBACK)
# ------------------------------------------------------------------------------
# D1_DATABASE_BINDING=DB
# R2_BUCKET_BINDING=
