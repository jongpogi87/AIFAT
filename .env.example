# ==============================================================================
# AIFAT REGISTRATION SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# The Signal School, Signal Regiment, Philippine Army
# ==============================================================================

# Application Environment (production | development | test)
NODE_ENV=production

# Public Base URL of the portal (used for verification links and redirects)
NEXT_PUBLIC_APP_URL=https://aifat.tss.army.mil.ph

# HMAC / Session secret key for administrative sessions (min 32 characters)
# Generate via: openssl rand -base64 32
SESSION_SECRET=YOUR_SECURE_HMAC_SESSION_SECRET_HERE

# Initial administrative bootstrap password (only consumed if admin_users is empty)
ADMIN_INITIAL_PASSWORD=YOUR_STRONG_INITIAL_ADMIN_PASSWORD_HERE

# Cloudflare D1 Database Binding Name
# Corresponds to the binding defined in .openai/hosting.json and Cloudflare Workers
D1_DATABASE_BINDING=DB

# Optional: Cloudflare R2 Storage (if media or file attachments are enabled)
R2_BUCKET_BINDING=

# Operational Contact Overrides (leave empty to use system defaults)
OFFICE_NAME=The Signal School, Signal Regiment, Philippine Army
OFFICE_ADDRESS=Fort Andres Bonifacio, Taguig City, Metro Manila
OFFICE_HOURS=Monday to Friday, 0800H – 1700H
CONTACT_PHONE=Pending Official TSS Announcement
CONTACT_EMAIL=Pending Official TSS Announcement
